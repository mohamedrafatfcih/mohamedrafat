---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import EmptyState from '../../components/EmptyState.astro';
import { getPosts, href } from '../../lib/site';
import { collectTags } from '../../lib/content.mjs';
const posts = await getPosts();
const tags = collectTags(posts);
---
<Base title="Blog" description="Technical writing, engineering notes, and explorations across technologies."><div class="container page-content"><header class="page-header"><p class="eyebrow">A notebook, across disciplines</p><h1>Notes &<br /><em>perspectives.</em></h1><p>Things I’ve learned, problems I’ve worked through, and technologies worth exploring.</p></header>{tags.length > 0 && <nav class="topic-nav" aria-label="Browse by technology"><a class="topic-pill active" href={href('blog/')} aria-current="page">All writing <span>{posts.length}</span></a>{tags.map((tag) => <a class="topic-pill" href={href(`blog/topics/${tag.slug}/`)}>{tag.label}<span>{tag.count}</span></a>)}</nav>}{posts.length ? <PostList posts={posts} /> : <EmptyState eyebrow="The notebook is open" title="The first page is still ahead." description="No articles have been published yet. New posts will appear here, organized by technology so you can follow the topics that interest you." />}</div></Base>
