---
import Base from './Base.astro';
import TagList from '../components/TagList.astro';
import { href } from '../lib/site';
interface Props { title: string; description: string; section: string; back: string; meta?: string; tags?: string[]; }
const { title, description, section, back, meta, tags = [] } = Astro.props;
---
<Base title={title} description={description} article>
  <article class="container article-shell">
    <a class="back-link" href={href(back)}>← All {section.toLowerCase()}</a>
    <header class="article-header"><span class="eyebrow">{section}</span><h1>{title}</h1><p class="article-description">{description}</p>{meta && <p class="meta">{meta}</p>}{tags.length > 0 && <TagList tags={tags} linked={section === 'Writing'} />}</header>
    <div class="prose"><slot /></div>
  </article>
</Base>
